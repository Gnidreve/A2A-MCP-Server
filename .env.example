# Copy to .env and adjust. Used by docker-compose.yml / docker-compose.proxy.yml.

# Comma-separated A2A agent URLs to register automatically on startup.
# Agents must already run their own A2A-v1-compatible server (inbound).
# Example: A2A_SEED_AGENTS=http://goclaw:8080,https://agent.example.com
A2A_SEED_AGENTS=

# Host port the bridge is published on when using docker-compose.yml
# (not used with docker-compose.proxy.yml, which only exposes it internally
# behind the proxy service).
MCP_PORT=8000

# Required only for docker-compose.proxy.yml: bearer token clients must send
# as `Authorization: Bearer <token>` to reach the bridge through the Caddy
# proxy. Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=
